# Local credentials and machine-specific tooling.
/.env
/.env.*
!/.env.example
/.aws/
/.agents/
/.codex/

# Airflow-generated configuration, logs, SQLite databases, and process files.
/config/airflow.cfg
/airflow.cfg
/logs/
airflow.db
airflow.db-*
